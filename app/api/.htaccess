Options -Indexes

<Files "config.php">
    Require all denied
</Files>

<Files "telemetry_store.php">
    Require all denied
</Files>

<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

<FilesMatch "\.bak$">
    Require all denied
</FilesMatch>

<FilesMatch "^(test_.*\.php|.*_support\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(?!privacy-policy\.txt$).+\.txt$">
    Require all denied
</FilesMatch>

<Files "privacy-policy.txt">
    Require all granted
    ForceType text/plain
    AddDefaultCharset UTF-8
</Files>
